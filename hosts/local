all:
  hosts: "localhost"
  vars:
    domain: mycomp.local
    admin_username: admin
    admin_password: verypassword
    ssl_use_acme: false  # no Letsencrypt since we are running on localhost
    verbose: true  # debug since we running local
    lokal_secret: verysecret  # seed for autogenerated passwords (do not change after initial setup)
    project_root: "/opt/lokal"  # absolute path; make sure it is your user writeable
    backup_root: "/data/backup"  # absolute path; make sure it is your user writeable
    ansible_connection: local
    services:
    - adminer
    - mail
    mail_users:
      your.name: "your-password"  # will give you email account your.name@mycomp.local (admin@mycomp.local is created automatically)
